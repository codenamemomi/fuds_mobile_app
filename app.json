{
  "expo": {
    "name": "fuds_mobile_app",
    "slug": "fuds_mobile_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fudsmobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "FUDS uses your location to suggest a delivery address. You can always edit it before saving — GPS is often slightly off for Nigerian estates and gates.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FUDS uses your location to suggest a delivery address while you use the app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.codenamemomi.fuds_mobile_app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1D9E75",
          "image": "./assets/images/icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FUDS uses your location to suggest a delivery address. You can always edit it before saving — GPS is often slightly off for Nigerian estates and gates.",
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:8000",
      "apiBaseUrlComment": "Fallback backend origin used by src/config/backend.ts. Prefer EXPLICIT_BACKEND_URL in that file for a fixed LAN/prod URL. Android emulator: 10.0.2.2; physical device: your PC LAN IP.",
      "router": {},
      "eas": {
        "projectId": "6bc85f58-7829-478d-8f09-2934d1e0ac5b"
      }
    }
  }
}
